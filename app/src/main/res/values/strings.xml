    <!-- Help (design.md §5.21) -->
    <string name="about_text">Version %1$s\n\nA plain-text editor in the spirit of classic Windows Notepad.\n\nNo internet access. No tracking. Your files stay where you put them.</string>
    <string name="shortcuts_text">Ctrl+N\tNew\nCtrl+O\tOpen\nCtrl+S\tSave\nCtrl+Shift+S\tSave As\nCtrl+P\tPrint\nCtrl+Z\tUndo\nCtrl+Y, Ctrl+Shift+Z\tRedo\nCtrl+X / C / V\tCut / Copy / Paste\nDel\tDelete\nCtrl+A\tSelect All\nCtrl+F\tFind\nF3 / Shift+F3\tFind Next / Previous\nCtrl+H\tReplace\nCtrl+G\tGo To Line\nF5\tTime/Date\nCtrl+Plus / Minus / 0\tZoom in / out / reset\nCtrl+mouse wheel\tZoom\nEsc\tClose the find bar\nTab\tInsert a tab</string>
